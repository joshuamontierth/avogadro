{{- $url := trimSuffix "/" (env "SEARXNG_BASE_URL") -}}
<?xml version="1.0" encoding="UTF-8"?>
<OpenSearchDescription xmlns="http://a9.com/-/spec/opensearch/1.1/" xmlns:moz="http://www.mozilla.org/2006/browser/search/">
  <ShortName>Avogadro</ShortName>
  <Description>Private search</Description>
  <InputEncoding>UTF-8</InputEncoding>
  <Image type="image/svg+xml">{{$url}}/favicon.svg</Image>
  <Url type="text/html" method="get" template="{{$url}}/?q={searchTerms}"/>
  <Url type="application/x-suggestions+json" method="get" template="{{$url}}/autocompleter?q={searchTerms}"/>
  <moz:SearchForm>{{$url}}/</moz:SearchForm>
</OpenSearchDescription>
