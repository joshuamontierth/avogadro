# Copy to .env and fill in.

# SearXNG's secret key. Generate one with: openssl rand -hex 32
# Every host serving the same address needs the same value, because result images are signed with it.
SEARXNG_SECRET=

# The address people use to reach this instance.
SEARXNG_BASE_URL=https://search.example.com/

# Port on 127.0.0.1 where the page is published; put a reverse proxy or `tailscale serve` in front of it.
AVOGADRO_PORT=8888

# Answers to questions, from an Ollama server; leave OLLAMA_URL empty to turn them off.
# http://ollama:11434 is the one in docker-compose.yml (`docker compose --profile answers up -d`).
# ANSWER_HOLD_URL, if set, is sent {"seconds": n} when an answer starts and 0 when it ends,
# so a batch job sharing the model can pause for it.
OLLAMA_URL=
OLLAMA_MODEL=gemma4:26b-a4b-it-qat
ANSWER_HOLD_URL=

# Only for android/build.sh and logo/render.sh, as SSH destinations (user@host):
# a Linux host with the Android SDK in ~/Android/Sdk and Google Chrome, and a Windows host with adb
# on its PATH and the phone plugged in.
AVOGADRO_BUILDER=
AVOGADRO_INSTALLER=
# Optional, for android/build.sh publish: the other hosts serving this instance, as rsync
# destinations of their checkout (host:path), separated by spaces.
AVOGADRO_MIRRORS=
