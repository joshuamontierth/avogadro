# Copy to .env and fill in.

# SearXNG's secret key. Generate one with: openssl rand -hex 32
# Every host serving the same address needs the same value, because result images are signed with it.
SEARXNG_SECRET=

# The address people use to reach this instance.
SEARXNG_BASE_URL=https://search.example.com/

# Port on 127.0.0.1 where the page is published; put a reverse proxy or `tailscale serve` in front of it.
AVOGADRO_PORT=8888
